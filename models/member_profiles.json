{
  "table": "member_profiles",
  "soft_delete": true,
  "indexes": [
    {
      "columns": ["user_id"]
    }
  ],
  "schema": {
    "user_id": {
      "type": "integer",
      "required": true,
      "unique": true
    },
    "full_name": {
      "type": "string",
      "required": true,
      "max_length": 255
    },
    "gender": {
      "type": "string",
      "required": true,
      "enum": ["male", "female"]
    },
    "age": {
      "type": "integer",
      "required": true,
      "min_value": 18,
      "max_value": 99
    },
    "city": {
      "type": "string",
      "max_length": 120
    },
    "about": {
      "type": "text"
    }
  },
  "access": {
    "fetch": [{"role": "user"}, {"role": "admin"}],
    "search": [{"role": "user"}, {"role": "admin"}],
    "count": [{"role": "user"}, {"role": "admin"}],
    "exists": [{"role": "user"}, {"role": "admin"}],
    "create": [{"role": "user", "condition": "user_id = {user_id}"}, {"role": "admin"}],
    "update": [{"role": "user", "condition": "user_id = {user_id}"}, {"role": "admin"}],
    "delete": [{"role": "user", "condition": "user_id = {user_id}"}, {"role": "admin"}]
  }
}
